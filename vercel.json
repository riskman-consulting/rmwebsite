{
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog", "destination": "/blogs", "permanent": true },
    { "source": "/erm", "destination": "/services/risk-advisory/erm", "permanent": true },
    { "source": "/rbia", "destination": "/services/risk-advisory/rbia", "permanent": true },
    { "source": "/risk-assurance-and-advisory", "destination": "/services/risk-advisory", "permanent": true },
    { "source": "/digital-transformation", "destination": "/services/digital-transformation", "permanent": true },
    { "source": "/industries/banking", "destination": "/industries/banking-insurance", "permanent": true },
    { "source": "/industries/energy", "destination": "/industries/energy-utilities", "permanent": true },
    { "source": "/industries/retail", "destination": "/industries/retail-consumer", "permanent": true },
    { "source": "/industries/technology", "destination": "/industries", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/insights/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/industries/:id", "destination": "/app-shell.html" },
    { "source": "/careers/:jobId", "destination": "/app-shell.html" },
    { "source": "/events/emerging-awards", "destination": "/app-shell.html" },
    { "source": "/cms", "destination": "/app-shell.html" },
    { "source": "/cms/:path*", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/app-shell.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/seo-report.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
